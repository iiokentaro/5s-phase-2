# Large raw GeoJSON exports (too big for git; re-derive from QGIS/ or source)
data/raw/*.geojson
# Overture regional extracts (re-derive via src/fetch_overture_roads.py)
data/raw/*_overture_roads.parquet
data/raw/*_overture_roads_polygon.parquet
# ...except the two ADB inputs, tracked on purpose.
!data/raw/ADB_Innovation_Maharashtra.geojson
!data/raw/ADB_Innovation_Thailand.geojson

# Mapillary fetch outputs (re-derivable via src/fetch_mapillary_features.py)
data/mapillary/*.json
data/mapillary/.map_features_thailand.jsonl
data/mapillary/.map_features_maharashtra.jsonl

# write_geo_outputs no longer writes this file (superseded by
# outputs/segments_priority.parquet); kept ignored in case an older checkout
# or manual run leaves one behind.
outputs/segments_priority.geojson

# Written by priority_map.write_gpkg; over GitHub's 100MB limit, so kept local.
# outputs/segments_priority.gdb.zip is the file uploaded to ArcGIS Online.
outputs/segments_priority.gpkg

# folium/Leaflet HTML map exceeds GitHub's 100MB limit (inlines all geometry).
# The interactive map deliverable is now docs/index.html (MapLibre + PMTiles);
# this file is kept locally only as a byproduct of src/quick_reproduce.py.
outputs/priority_map.html

# Last pipeline-run state written by src/pipeline_service.py, so a restarted
# server can still show the chain it was in the middle of. Machine-local.
outputs/.pipeline_run.json
outputs/.pipeline_run.tmp

# osmnx HTTP response cache
cache/

# External downloads (OSM pbf, WorldPop rasters) -- large, re-derivable via
# the documented URLs in README.md
data/external/**
!data/external/**/

# Diagnostic-only extraction cache (src/road_class_coverage.py). Hundreds of MB,
# re-derivable from the pbf; never an input to the pipeline.
data/interim/**
!data/interim/**/

# Full-geometry OSM way layer (src/osm_ways.py): Thailand 492 MB, Maharashtra
# 299 MB, of which ~90% is geometry -- past GitHub's 100 MB per-file limit, and
# dropping the `tags` column would only save 7%.
#
# Every other data/processed/ parquet is tracked on purpose, for reproducibility
# from a clone. This one is not, because that reason does not apply to it: its
# input (data/external/*.osm.pbf) is already untracked, so a clone cannot use
# this file without first fetching the pbf -- at which point
#     python src/osm_ways.py --country both
# rebuilds it in 61 s (Thailand) / 36 s (Maharashtra), and every build is
# checked against the pbf's own declared counts by
# osm_way_source.assert_conservation. Tracking a large derivative of an
# untracked input buys nothing.
data/processed/osm_ways_*.parquet

# Geofabrik western-zone GPKG (~1 GB). Re-download from the URL in
# QGIS/western-zone-260919-free.gpkg/README; GitHub's file limit is 100 MB.
QGIS/western-zone-260919-free.gpkg/*.gpkg

# Valhalla routing tiles (数 GB、再生成可能)
valhalla/tiles/thailand/*
valhalla/tiles/maharashtra/*
!valhalla/tiles/thailand/.gitkeep
!valhalla/tiles/maharashtra/.gitkeep

# isochrone 生成済み parquet は原則コミット推奨だが、100 MB 超なら除外を検討
# data/processed/isochrones/*.parquet

# src/osm_way_source.py's highway_pbf()/buffered_boundary() cache derived pbf
# and boundary-buffer geojson files next to whatever source pbf they were built
# from (tests/fixtures/bkk_small.osm.pbf for the test suite). Each carries the
# clip boundary's mtime_ns in its name, so every test run that rebuilds the
# clip polygon (tests/test_osm_way_source_equivalence.py's per-test tmp
# boundary file) leaves a new, never-cleaned-up file behind. Re-derived
# automatically; only tests/fixtures/bkk_small.osm.pbf is a real fixture.
tests/fixtures/*.highways*.osm.pbf
tests/fixtures/*.buffer*m.geojson

# Local development notes (not for version control)
dev_docs/

# Local submission drafts (not for version control)
submission_form/

# macOS
.DS_Store

# StoryMap upload layers (docs/storymaps_idea/export_storymap_layers.ipynb); large, rebuilt on demand
docs/storymaps_idea/layers/
# Basemap tile cache of docs/storymaps_idea/create_3d_layered_image.ipynb
docs/storymaps_idea/images/.tile_cache/

# Empty-directory markers. The pipeline writes into data/ subdirectories that
# hold no committed file; keeping the markers gives a clone the same layout as
# the working repository. KICKSTART.md says which files go where.
!**/.gitkeep

# Mapillary POI cache, rebuilt by src/exposure_signals.py from the map-feature
# JSON. Mapillary data may not be redistributed, so it stays out of this
# repository; a run without the JSON writes an empty placeholder.
data/processed/mapillary_pois_*.parquet
